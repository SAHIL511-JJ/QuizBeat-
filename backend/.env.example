# Backend environment variables
# Copy this file to .env and fill in your values

# Groq API Key (get from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Firebase Admin SDK credentials (JSON string)
# Get from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_CREDENTIALS=

# Alternative Firebase Admin SDK credential style (optional)
# Use these instead of FIREBASE_CREDENTIALS if you prefer separate env vars.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# MCP auth settings
MCP_LOGIN_CODE_TTL_MINUTES=10
MCP_SESSION_TTL_DAYS=7

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
